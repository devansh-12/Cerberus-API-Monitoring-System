FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including devDependencies for tsx)
RUN npm install

# Copy application code
COPY . .

# Create logs directory
RUN mkdir -p logs

# Start the consumer with TypeScript support
CMD ["npx", "tsx", "src/services/processor/consumer.js"]
