{
  "name": "api-hit-monitoring",
  "version": "1.0.0",
  "description": "Real-Time API Hit Tracking & Monitoring System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "processor": "node src/modules/ingest/consumer.js",
    "init": "node init-system.js",
    "init:env": "node init-system.js --generate-env",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "playwright test",
    "test:e2e:setup": "bash scripts/test-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "seed": "tsx scripts/seed-databases.js",
    "seed:clean": "tsx scripts/seed-databases.js --clean",
    "seed:large": "tsx scripts/seed-databases.js --clients 5 --hits 2000",
    "seed:help": "tsx scripts/seed-databases.js --help",
    "seed:validate": "tsx scripts/validate-seed.js"
  },
  "keywords": [
    "api",
    "monitoring",
    "tracking",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "amqplib": "^0.10.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "pg": "^8.11.3",
    "rate-limit-redis": "^4.3.1",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
