# MongoDB
MONGO_URI=mongodb://localhost:27017/api_monitoring
MONGO_DB_NAME=api_monitoring

# PostgreSQL
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=api_monitoring
PG_USER=postgres
PG_PASSWORD=postgres123
POSTGRES_PASSWORD=postgres123

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/api_monitoring
RABBITMQ_QUEUE=api_hits
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=rabbit123
JWT_SECRET=8566a988e9dd2c19df0b5b0c6595eea37160954571250cf6304ee6e62a9abe47

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_VALID=300       # seconds — valid API key cache lifetime (5 min)
REDIS_CACHE_TTL_INVALID=60      # seconds — negative cache lifetime (1 min)

# Docker Services
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Rate Limiting (controlled via .env, referenced in docker-compose.yml)
# Set to 999999 for throughput benchmark, 100 for resilience benchmark / production
RATE_LIMIT_MAX_REQUESTS=100

# Consumer tuning (benchmark/production)
CONSUMER_PREFETCH=50      # max concurrent unacked messages the consumer processes at once
PG_POOL_MAX=50            # Postgres connection pool size (should be >= CONSUMER_PREFETCH)
