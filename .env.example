POSTGRES_PASSWORD=your_secure_password
RABBITMQ_DEFAULT_USER=api_user
RABBITMQ_DEFAULT_PASS=secure_password
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
JWT_SECRET=super_secret_jwt_key_minimum_32_chars

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_VALID=300       # seconds — valid API key cache lifetime (5 min)
REDIS_CACHE_TTL_INVALID=60      # seconds — negative cache lifetime (1 min)
